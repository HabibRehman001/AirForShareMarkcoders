PORT=3001
MONGODB_URI=

# Single admin account (no signup)
ADMIN_USERNAME=MarkcodersAdmin

# bcrypt hash of the password (NOT the plain password) — keep quotes!
# Generate with: node -e "import('bcryptjs').then(b=>b.hash('YOUR_PASSWORD',12).then(console.log))"
ACCOUNT_PASS="$2a$12$replaceWithYourHash"

# Random secret for JWT signing
JWT_SECRET=

# Optional: frontend URL for CORS + cookies (required in production)
# FRONTEND_URL=https://airforsharemarkcoders-1.onrender.com
FRONTEND_URL=
