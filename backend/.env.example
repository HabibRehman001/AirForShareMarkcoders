PORT=3001
MONGODB_URI=

# Random secret for JWT signing
JWT_SECRET=

# Optional: force Secure + SameSite=None cookies (needed for Render → anton)
# COOKIE_SECURE=true

# Admin user is seeded into the `users` collection on startup
# (MarkCodersAdmin + bcrypt hash in server.js). Change via DB or seed constants.

# Optional: max upload size (default 10GB)
# MAX_FILE_SIZE_BYTES=10737418240
# MAX_FILE_SIZE_LABEL=10GB

# Comma-separated public IPs of allowed Wi‑Fi networks (empty = allow all)
# ALLOWED_IPS=203.0.113.10,198.51.100.20
